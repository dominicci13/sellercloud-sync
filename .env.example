# --- Alerting -------------------------------------------------------------
# Outlook account used by seller_automation_utils.alert_utils.handle_crash to
# email a screenshot + traceback if a run fails, with an optional AI summary
# on top and a note saved to the knowledge base.
ALERT_EMAIL=alerts@example.com
# Optional AI crash summary (crash_explainer). All have defaults; CRASH_AI=0 turns it off.
# CRASH_AI=1
# CRASH_AI_MODEL=gpt-5.5
# CRASH_AI_EFFORT=high
# CRASH_AI_TIMEOUT=120
# CRASH_AI_KB_DIR=C:\path\to\knowledge-base

# --- SQL Server tables ----------------------------------------------------
# Destination table name (default shown).
DB_TABLE_SELLERCLOUD=SellerCloud
